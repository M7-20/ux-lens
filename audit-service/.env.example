# مزوّد الرؤية (vision_provider.py) — "gemini" (افتراضي، للتطوير المحلي) أو
# "ministry" (بوابة الوزارة عبر /chat/completions متوافقة OpenAI — راجع توثيق
# الوحدة في vision_provider.py لما هو مؤكَّد وما هو غير مؤكَّد حول هذا المزوّد،
# خصوصاً مسألة box_2d/الإحداثيات).
VISION_PROVIDER=gemini

# --- مزوّد gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- مزوّد ministry (نفس أسماء متغيرات autoglean: VISION_API_BASE/VISION_API_KEY/VISION_MODEL) ---
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=
VISION_VERIFY_SSL=true

WAHA_SSO=on
WAHA_PUBLIC_KEY_PATH=/app/waha_public_key.pem
