# waha ONBOARDING.md §2: the value is the platform prefix PLUS this app's own
# segment, not the segment alone — "/uxlens" resolves assets against the
# platform ROOT instead of the shell's own base and 404s (the exact mistake
# the onboarding guide calls out). Current platform base per ONBOARDING.md §1
# is "/waha"; if that ever moves, this one string is what changes.
VITE_BASE_PATH=/waha/uxlens
VITE_AUDIT_SERVICE_URL=http://localhost:8000/api
