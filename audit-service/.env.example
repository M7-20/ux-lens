# ── الرؤية (VLM) واللغة (LLM) عبر بوابة الوزارة ─────────────────────────
# نقطة واحدة متوافقة مع OpenAI تخدم الاثنين: جزء image_url يذهب لنموذج
# الرؤية، والنص العادي لنموذج اللغة. المفاتيح تُصدَر وتُدار من autoglean نفسه
# (صفحة تدقيق نموذج اللغة ← تبويب المفاتيح)، وكل استدعاء يُسجَّل باسم مفتاحه.
#
# داخل الخادم استخدم العنوان الداخلي، لا العام: الخادم لا يستطيع تحليل اسم
# مضيفه العام إلى نفسه، فالعنوان العام يعلّق حتى تنتهي المهلة.
#   داخل الخادم:               http://host.docker.internal:8101/v1
#   من جهاز داخل شبكة الوزارة:  https://etd.mewa.gov.sa/waha/autoglean/v1
MINISTRY_VLM_BASE_URL=http://host.docker.internal:8101/v1
MINISTRY_VLM_API_KEY=

# يمكن أن يكون نفس مفتاح الرؤية وعنوانها — نفس النقطة تخدم الاثنين.
MINISTRY_LLM_BASE_URL=http://host.docker.internal:8101/v1
MINISTRY_LLM_API_KEY=

# ── تكامل منصة واحة ─────────────────────────────────────────────────────
# قفل تحقق هوية واحة — الافتراضي المنشور "on". "off" صمّام أمان فقط
# (§5.1 من دليل onboarding واحة: "مصمَّم عمداً ليبقى يعمل").
WAHA_SSO=on
WAHA_PUBLIC_KEY_PATH=/app/waha_public_key.pem
